# Maintainer: sazardev <sazardev@users.noreply.github.com>
# The prebuilt release (glibc 2.31+, built with cargo-zigbuild). Verified against the release signature: import the
# key once first (gpg --import packaging/leader-releases.asc), makepkg checks it against validpgpkeys below.
pkgname=leader-editor-bin
pkgver=1.14.2
pkgrel=1
pkgdesc='Neovim with a fast, opinionated config in its own GPU window (prebuilt)'
arch=('x86_64')
url='https://sazardev.github.io/leader/'
license=('MIT')
depends=('glibc' 'git' 'curl' 'neovim>=0.11')
optdepends=('ripgrep: project search'
            'fd: file search'
            'vulkan-icd-loader: GPU drawing (OpenGL works without it)'
            'wayland: Wayland sessions'
            'libxkbcommon: keyboard handling')
provides=('leader-editor')
conflicts=('leader-editor')
options=('!strip')
source=("leader-$pkgver-linux-x86_64.tar.gz::https://github.com/sazardev/leader/releases/download/v$pkgver/leader-linux-x86_64.tar.gz"
        "leader-$pkgver-linux-x86_64.tar.gz.asc::https://github.com/sazardev/leader/releases/download/v$pkgver/leader-linux-x86_64.tar.gz.asc")
sha256sums=('c140f7f2c00810d7e4f8bc9f8257b95a5368f2c7810d5f7ba566d9e03235d1cc' 'SKIP')
# Leader Releases (release signing key), also in packaging/leader-releases.asc of the repository
validpgpkeys=('8E437A7936E48EAEDA88CD73A7DCC3DBB671476A')

package() {
  cd "leader-$pkgver-linux-x86_64"
  install -d "$pkgdir/usr"
  cp -a bin share "$pkgdir/usr/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
