#!/bin/sh
# Keeps CHEATSHEET.md up to date: if the commit touches the nvim config, it regenerates it
# from the real keymaps and adds it to the commit. Never blocks the commit: if nvim
# or the plugins are missing, it only warns.
# Enable once per clone: git config core.hooksPath .githooks
git diff --cached --name-only | grep -q '^nvim/' || exit 0

ROOT="$(git rev-parse --show-toplevel)"
if ! "$ROOT/scripts/gen-cheatsheet.sh"; then
  echo "pre-commit: could not regenerate CHEATSHEET.md (are nvim and the plugins installed?)" >&2
  exit 0
fi
git add "$ROOT/CHEATSHEET.md"
