#!/bin/sh
# Requires Conventional Commits on the first line: `type(scope)!: subject`.
# The types are those of settings.git.commit.types (nvim/lua/core/settings.lua): if you change
# the list there, change it here. Lets git's merges, reverts and fixup!/squash! through.
# Enable once per clone: git config core.hooksPath .githooks
TYPES='feat|fix|refactor|docs|style|perf|test|build|ci|chore|revert'
MAX=72

header="$(grep -v '^#' "$1" | sed -n '1p')"

case "$header" in
  Merge\ *|Revert\ \"*|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

if ! printf '%s' "$header" | grep -Eq "^($TYPES)(\([^()]+\))?!?: .+"; then
  cat >&2 <<MSG
commit-msg: the message does not follow Conventional Commits.
  first line: "$header"
  format:     type(scope): subject      (the scope is optional)
  types:      $(echo "$TYPES" | tr '|' ' ')
  example:    feat(session): periodic autosave
  from nvim:  <leader>Gc (wizard) or <leader>Gm (AI message)
MSG
  exit 1
fi

if [ "${#header}" -gt "$MAX" ]; then
  echo "commit-msg: the first line has ${#header} characters (maximum $MAX)." >&2
  exit 1
fi
