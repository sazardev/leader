# Secrets: environment files, keys and credentials that must never reach the history
# detect: always .env .env.* *.pem *.key *.p12 *.pfx *.jks *.keystore *.kdbx id_rsa id_ed25519 credentials.json
# Environment files (keep the example, commit it as the template)
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.env

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
!*.pub

# Cloud and service credentials
credentials.json
service-account*.json
*-credentials.json
.aws/credentials
.gcloud/
.azure/
secrets.json
secrets.yml
secrets.yaml
secrets.toml
secrets.env
*.secret
*.secrets

# Password databases
*.kdbx
