build/
build-*/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
Testing/
_deps/

# Tooling output (clangd, debuggers, profilers)
.cache/
compile_commands.json
*.dSYM/
*.gcda
*.gcno
core
vgcore.*
