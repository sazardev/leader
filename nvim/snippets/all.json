{
  "TODO": {
    "prefix": [
      "todo"
    ],
    "body": [
      "${LINE_COMMENT} TODO: ${0:something still to do}"
    ],
    "description": "TODO comment (works in any language)"
  },
  "TODO-owner": {
    "prefix": [
      "todoo"
    ],
    "body": [
      "${LINE_COMMENT} TODO(${1:name}): ${0:something still to do}"
    ],
    "description": "TODO comment with owner"
  },
  "FIXME": {
    "prefix": [
      "fixme"
