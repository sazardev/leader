{
  "pytest test": {
    "prefix": [
      "testfunction"
    ],
    "body": [
      "def test_${1:behaviour}() -> None:",
      "\t${2:result = }",
      "\tassert ${0:result}"
    ],
    "description": "a pytest test"
  },
  "pytest parametrize": {
    "prefix": [
      "parametrize"
    ],
    "body": [
      "@pytest.mark.parametrize(",
      "\t(\"${1:value}\", \"${2:expected}\"),",
      "\t[",
      "\t\t(${3}, ${4}),",
      "\t],",
      ")",
      "def test_${5:name}($1, $2) -> None:",
      "\tassert ${0}"
    ],
    "description": "a parametrized pytest test"
  },
  "pytest fixture": {
    "prefix": [
      "fixture"
    ],
    "body": [
      "@pytest.fixture",
      "def ${1:name}() -> ${2:Iterator[Thing]}:",
      "\t${3:thing = Thing()}",
      "\tyield ${4:thing}",
      "\t${0}"
    ],
    "description": "a pytest fixture with teardown"
  },
  "dataclass": {
    "prefix": [
      "dataclass"
    ],
    "body": [
      "@dataclass(frozen=True, slots=True)",
      "class ${1:Name}:",
      "\t${2:field}: ${3:str}",
      "\t${0}"
    ],
    "description": "a frozen dataclass"
  },
  "main guard": {
    "prefix": [
      "ifmain"
    ],
    "body": [
      "def main() -> None:",
      "\t${0:pass}",
      "",
      "",
      "if __name__ == \"__main__\":",
      "\tmain()"
    ],
    "description": "main() and the __main__ guard"
  },
  "typed exception": {
    "prefix": [
      "exception"
    ],
    "body": [
      "class ${1:Name}Error(Exception):",
      "\t\"\"\"${2:What went wrong.}\"\"\"",
      "",
      "\tdef __init__(self, ${3:detail}: ${4:str}) -> None:",
      "\t\tsuper().__init__(f\"${5:message}: {$3}\")",
      "\t\tself.$3 = $3"
    ],
    "description": "an exception with its data"
  },
  "read csv": {
    "prefix": [
      "readcsv"
    ],
    "body": [
      "${1:df} = pd.read_csv(\"${2:data/}\")",
      "${0}"
    ],
    "description": "read a CSV into a DataFrame (path completion inside the string)"
  },
  "read excel": {
    "prefix": [
      "readexcel"
    ],
    "body": [
      "${1:df} = pd.read_excel(\"${2:data/}\")",
      "${0}"
    ],
    "description": "read an Excel sheet into a DataFrame"
  },
  "read parquet": {
    "prefix": [
      "readparquet"
    ],
    "body": [
      "${1:df} = pd.read_parquet(\"${2:data/}\")",
      "${0}"
    ],
    "description": "read a parquet file into a DataFrame"
  },
  "read json": {
    "prefix": [
      "readjson"
    ],
    "body": [
      "${1:df} = pd.read_json(\"${2:data/}\")",
      "${0}"
    ],
    "description": "read a JSON file into a DataFrame"
  },
  "dataframe head": {
    "prefix": [
      "dfhead"
    ],
    "body": [
      "${1:df}.head(${2:5})"
    ],
    "description": "the first rows of a DataFrame"
  },
  "dataframe info": {
    "prefix": [
      "dfinfo"
    ],
    "body": [
      "${1:df}.info()"
    ],
    "description": "columns, types and nulls of a DataFrame"
  },
  "numpy array": {
    "prefix": [
      "nparray"
    ],
    "body": [
      "np.array(${1:values}${2:, dtype=${3:float}})"
    ],
    "description": "np.array with the standard numpy alias (import added automatically)"
  },
  "numpy linspace": {
    "prefix": [
      "nplinspace"
    ],
    "body": [
      "np.linspace(${1:0}, ${2:1}, ${3:100})"
    ],
    "description": "evenly spaced numbers (import added automatically)"
  },
  "pandas dataframe": {
    "prefix": [
      "pddf"
    ],
    "body": [
      "pd.DataFrame(${1:data}, columns=${2:[${3:\"a\", \"b\"}]})"
    ],
    "description": "pd.DataFrame with the standard pandas alias (import added automatically)"
  },
  "matplotlib subplots": {
    "prefix": [
      "pltfig"
    ],
    "body": [
      "fig, ax = plt.subplots(${1:1}, ${2:1}, figsize=(${3:10}, ${4:6}))",
      "${0}"
    ],
    "description": "figure and axes with the standard plt alias (import added automatically)"
  },
  "train test split": {
    "prefix": [
      "sksplit"
    ],
    "body": [
      "X_train, X_test, y_train, y_test = train_test_split(",
      "\t${1:X}, ${2:y}, test_size=${3:0.2}, random_state=${4:42}",
      ")"
    ],
    "description": "sklearn train/test split (import added automatically)"
  },
  "sklearn pipeline": {
    "prefix": [
      "skpipe"
    ],
    "body": [
      "Pipeline([",
      "\t(${1:\"scaler\"}, StandardScaler()),",
      "\t(${2:\"model\"}, ${3:LogisticRegression()}),",
      "])"
    ],
    "description": "scikit-learn pipeline (imports added automatically)"
  },
  "classification report": {
    "prefix": [
      "skreport"
    ],
    "body": [
      "print(classification_report(${1:y_test}, ${2:y_pred}))"
    ],
    "description": "sklearn classification report (import added automatically)"
  },
  "scipy minimize": {
    "prefix": [
      "spmin"
    ],
    "body": [
      "minimize(${1:func}, ${2:x0}, method=${3:\"BFGS\"})"
    ],
    "description": "scipy.optimize.minimize (import added automatically)"
  },
  "plotly express figure": {
    "prefix": [
      "pxfig"
    ],
    "body": [
      "fig = px.${1:line}(${2:df}, x=${3:\"x\"}, y=${4:\"y\"})",
      "fig.show()"
    ],
    "description": "plotly express figure with the standard px alias (import added automatically)"
  }
}