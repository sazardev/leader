{
  "create table": {
    "prefix": [
      "createtable"
    ],
    "body": [
      "create table ${1:items} (",
      "\tid bigint generated always as identity primary key,",
      "\t${2:name} text not null,",
      "\tcreated_at timestamptz not null default now(),",
      "\tupdated_at timestamptz not null default now()",
      ");"
    ],
    "description": "a PostgreSQL table with id and timestamps"
  },
  "create index": {
    "prefix": [
      "createindex"
    ],
    "body": [
      "create index ${1:items}_${2:name}_idx on $1 ($2);"
    ],
    "description": "an index"
  },
  "upsert": {
    "prefix": [
      "upsert"
    ],
    "body": [
      "insert into ${1:items} (${2:id}, ${3:name})",
      "values (${4}, ${5})",
      "on conflict ($2) do update set $3 = excluded.$3;"
    ],
    "description": "insert or update (PostgreSQL, SQLite)"
  },
  "with query": {
    "prefix": [
      "withquery"
    ],
    "body": [
      "with ${1:recent} as (",
      "\tselect ${2:*} from ${3:items} where ${4:created_at > now() - interval '7 days'}",
      ")",
      "select ${0:*} from $1;"
    ],
    "description": "a query with a CTE"
  },
  "transaction": {
    "prefix": [
      "transaction"
    ],
    "body": [
      "begin;",
      "${0}",
      "commit;"
    ],
    "description": "a transaction"
  },
  "mysql create table": {
    "prefix": [
      "mysqlcreatetable"
    ],
    "body": [
      "create table ${1:items} (",
      "\tid bigint unsigned not null auto_increment primary key,",
      "\t${2:name} varchar(255) not null,",
      "\tcreated_at timestamp not null default current_timestamp,",
      "\tupdated_at timestamp not null default current_timestamp on update current_timestamp",
      ") engine=InnoDB default charset=utf8mb4;"
    ],
    "description": "a MySQL table with an auto-increment id and timestamps"
  },
  "mysql upsert": {
    "prefix": [
      "mysqlupsert"
    ],
    "body": [
      "insert into ${1:items} (${2:id}, ${3:name})",
      "values (${4}, ${5})",
      "on duplicate key update $3 = values($3);"
    ],
    "description": "insert or update (MySQL, MariaDB)"
  },
  "sqlite upsert": {
    "prefix": [
      "sqliteupsert"
    ],
    "body": [
      "insert into ${1:items} (${2:id}, ${3:name})",
      "values (${4}, ${5})",
      "on conflict ($2) do update set $3 = excluded.$3;"
    ],
    "description": "insert or update (SQLite)"
  },
  "sql server table": {
    "prefix": [
      "tsqlcreatetable"
    ],
    "body": [
      "create table ${1:items} (",
      "\tid bigint identity(1,1) primary key,",
      "\t${2:name} nvarchar(255) not null,",
      "\tcreated_at datetime2 not null default sysutcdatetime()",
      ");"
    ],
    "description": "a SQL Server table with an identity id and UTC timestamps"
  },
  "sql server merge": {
    "prefix": [
      "tsqlmerge"
    ],
    "body": [
      "merge into ${1:items} as target",
      "using (values (${2:1}, ${3:'name'})) as source (id, name)",
      "on target.id = source.id",
      "when matched then update set name = source.name",
      "when not matched then insert (id, name) values (source.id, source.name);"
    ],
    "description": "upsert with MERGE (SQL Server)"
  },
  "select with limit": {
    "prefix": ["selectlimit"],
    "body": ["select ${1:*} from ${2:table} limit ${3:10};"],
    "description": "a short select with a row limit"
  },
  "count rows": {
    "prefix": ["countrows"],
    "body": ["select count(*) from ${1:table} where ${2:1 = 1};"],
    "description": "count the rows that match"
  },
  "left join": {
    "prefix": ["leftjoin"],
    "body": ["select ${1:*} from ${2:table} a", "left join ${3:other} b on a.${4:id} = b.${4:id};"],
    "description": "a left join with an alias on both sides"
  },
  "group and count": {
    "prefix": ["groupcount"],
    "body": [
      "select ${1:column}, count(*) from ${2:table}",
      "group by ${1:column}",
      "order by count(*) desc limit ${3:10};"
    ],
    "description": "group, count and take the top rows"
  },
  "where in": {
    "prefix": ["wherein"],
    "body": ["where ${1:column} in (${2:1}, ${3:2});"],
    "description": "a WHERE … IN list"
  }
}