<!-- AppStream metadata: what software centers (GNOME Software, KDE Discover, AppCenter) show. The <releases> block is
     written by app/package.sh from CHANGELOG.md (between the markers). -->
<component type="desktop-application">
  <id>io.github.sazardev.Leader</id>
  <name>Leader</name>
  <summary>Neovim with a fast, opinionated config in its own GPU window</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <developer id="io.github.sazardev">
    <name>sazardev</name>
  </developer>
  <description>
    <p>
      Leader is Neovim for working: a small, opinionated config that starts in about 20 ms, in a native window drawn
      with your GPU. Zed-like menus, a command palette, your projects with their sessions, an inline AI agent and the
      whole of Neovim underneath: every key you know still works.
    </p>
    <p>Highlights:</p>
    <ul>
      <li>Asks which project to open, with pinned projects and a Yazi-style folder browser</li>
      <li>Full mouse support next to a keyboard-first design; Esc closes whatever is extra</li>
      <li>Language servers, formatters and linters installed for the languages you use, with live progress</li>
      <li>Checks for updates and shows what changed before you update; never updates by itself</li>
      <li>Runs on Linux (Wayland and X11) and on Windows through WSL</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.sazardev.Leader.desktop</launchable>
